PORT=3000
NODE_ENV=development
# Local MongoDB. With Docker Compose this is overridden to mongodb://mongo:27017
MONGODB_URI=mongodb://127.0.0.1:27017
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
# Rate limiting for POST /signup and POST /login (requests per window per IP)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
# General API rate limit
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MIN=15
